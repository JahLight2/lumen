# Copy to .env for local use. NEVER commit .env or real tokens.
# All variables are optional; the CLI works with defaults.

# Where the catalogue database lives (default: data/catalogue.db)
LFMC_DB=data/catalogue.db

# Bearer token for /media/* and mutating endpoints.
# Leave unset to let the server generate one into data/catalogue.token (mode 0600).
# LFMC_TOKEN=replace-with-a-long-random-string

# Synthetic sample drive used by `seed-demo`
LFMC_SAMPLE_DIR=data/sample_drive

# Set to 1 for request logging (never logs tokens or file contents)
# LFMC_VERBOSE=1
